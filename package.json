{
  "name": "discord-bot-become-human-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord group-chat AI agent bot with guild-isolated workspaces and Codex-backed agent runs.",
  "bin": {
    "discord-bot-become-human-2": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/scripts/login-openai-codex.ts --format esm --dts --clean --sourcemap",
    "check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "login:codex": "tsx src/scripts/login-openai-codex.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@langfuse/client": "^5.13.1",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
